# Caisse Meyrin FC — service des fichiers
#
# 1. L'URL nue du domaine doit exécuter index.php, jamais servir index.html
#    directement. Sans cette ligne, l'ordre par défaut du serveur peut placer
#    index.html en premier : la page serait alors servie sans passer par
#    l'authentification ni recevoir les permissions de l'utilisateur.
DirectoryIndex index.php

# 2. index.html n'est pas une page, c'est le gabarit lu par index.php.
#    On interdit d'y accéder directement par son URL. La lecture depuis le
#    disque par PHP n'est pas concernée par cette règle.
<Files "index.html">
    Require all denied
</Files>

# 3. Le gabarit ne doit jamais rester en cache navigateur : il contient les
#    permissions injectées, qui changent quand un rôle change.
<IfModule mod_headers.c>
    <FilesMatch "index\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
