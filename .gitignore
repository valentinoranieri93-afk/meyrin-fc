# Serveur
.user.ini
.infomaniak-maintenance.html

# Données sensibles
**/caisse_data.json
**/*.sqlite
**/data/uploads/

# Environnement
.env
*.env

# État vivant du serveur — ne doit jamais être versionné ni redéployé
# (leçon du 2026-07-10 : ré-uploader data/ écrase les comptes réels)
erp.meyrinfc.ch/data/users.json
erp.meyrinfc.ch/data/logs.json
erp.meyrinfc.ch/data/revocations.json
# Référentiel club (catégories, équipes, entraîneurs par saison) : édité depuis
# l'ERP, il porte les identifiants d'équipe auxquels RH et Arbitrage rattachent
# leurs affectations et leurs matchs. Le redéployer détacherait ces données.
erp.meyrinfc.ch/data/club_structure.json
# Référentiel des contacts : données personnelles, dont celles de mineurs, et
# état vivant du serveur. Ne doit jamais entrer dans le dépôt ni être redéployé.
erp.meyrinfc.ch/data/contacts.sqlite*

# Dossiers de sauvegarde locaux
_Backup/
**/_Backup/
**/*.bak-*

# Outils de diagnostic temporaires déposés à la racine d'une app
mfc_check.php

# Fiches de paie et documents personnels — donnees financieres nominatives,
# ne doivent jamais quitter le serveur ni entrer dans l'historique du depot
erp.meyrinfc.ch/rh/data/

# Fichiers d'import de contacts : le modele vide est versionne, jamais les
# fichiers remplis (donnees personnelles, dont celles de mineurs)
imports/*
!imports/modele-import-contacts.xlsx
erp.meyrinfc.ch/data/general.json

# Comptabilite : la base porte le journal, les factures et les coordonnees
# bancaires des tiers ; uploads/ porte les factures fournisseurs scannees.
# Etat vivant du serveur, jamais versionne ni redeploye. Le .htaccess qui ferme
# le dossier, lui, doit rester dans le depot.
erp.meyrinfc.ch/compta/data/
erp.meyrinfc.ch/compta/uploads/*
!erp.meyrinfc.ch/compta/uploads/.htaccess
